DATABASE_URL=postgres://autoclip:autoclip@localhost:5432/autoclip
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoclip
API_KEY_PEPPER=change-me-to-a-long-random-string
WEBHOOK_SIGNING_SECRET=change-me-to-another-long-random-string
OLLAMA_URL=
ML_SIDECAR_URL=
FFMPEG_HWACCEL=none
WORKER_CONCURRENCY_RENDER=2
WORKER_CONCURRENCY_ANALYZE=1
WORKER_CONCURRENCY_COLLAGE=1
MAX_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=200
COLLAGE_MAX_IMAGES=20
COLLAGE_MAX_INPUT_PIXELS=200000000
COLLAGE_MAX_CANVAS_PIXELS=40000000
COLLAGE_MAX_DIMENSION=8192
# Folder of collage template JSON files (relative to the working directory).
COLLAGE_TEMPLATES_DIR=assets/collage-templates
# Largest polaroid carousel spread (slides x slide width x slide height), in pixels.
COLLAGE_POLAROID_MAX_SPREAD_PIXELS=20000000
# Caption font for polaroid carousels (relative to the working directory). The worker image must
# include this file.
POLAROID_FONT_PATH=assets/fonts/Caveat-Regular.ttf
# Video slideshow runtime limits (mode: "slideshow" on POST /api/collages).
SLIDESHOW_MAX_SLIDES=20
SLIDESHOW_MAX_SLIDE_SEC=30
SLIDESHOW_MAX_DURATION_SEC=300
SLIDESHOW_MAX_TRANSITION_SEC=2
# Optional: an issued API key (npm run create-key) that the web UI uses automatically for
# same-origin requests. Anyone who can reach the server can use it; trusted self-hosting only.
STUDIO_API_KEY=
LOG_LEVEL=info
